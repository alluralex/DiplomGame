--- !u!114 &1981430908
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1981430906}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e46be4ef885f3cf4d8ea761100a49f02, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  tutorialPanel: {fileID: 507983487}
  tutorialText: {fileID: 2031232227}
  tutorialSteps:
  - "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C,
    \u044F - \u0413\u0435\u0440\u0442\u0430, \u043A\u043E\u0442, \u0437\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
    \u0432\u044B \u0431\u0443\u0434\u0435\u0442\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u044C
    \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435 \u0438 \u0438\u0433\u0440\u0430\u0442\u044C
    \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u0443\u044E \u0438\u0433\u0440\u0443.
    \n\u0421\u043C\u044B\u0441\u043B \u0438\u0433\u0440\u044B - \u0434\u043E\u0439\u0442\u0438
    \u0434\u043E \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u0432\u043E\u043B\u043D\u044B
    \u0438 \u0443\u0431\u0438\u0442\u044C \u0431\u043E\u0441\u0441\u0430.\r\n"
  - "\u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430 \u0434\u0430\u0432\u0430\u0439\u0442\u0435
    \u043F\u0435\u0440\u0435\u0439\u0434\u0451\u043C \u0432 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C,
    \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043A\u043D\u043E\u043F\u043A\u0443
    R \u043D\u0430 \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0435."
  - "\u0412 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435 \u0435\u0441\u0442\u044C
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u043A\u043B\u0430\u0434\u043E\u043A.
    \u043F\u0435\u0440\u0432\u0430\u044F \u0432\u043A\u043B\u0430\u0434\u043A\u0430
    - \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C, \u0437\u0430\u043A\u0440\u043E\u0439
    \u0435\u0433\u043E \u0438 \u0434\u043E\u0431\u0443\u0434\u044C \u043B\u044E\u0431\u043E\u0439
    \u0440\u0435\u0441\u0443\u0440\u0441 \u043F\u0440\u0438 \u043F\u043E\u043C\u043E\u0449\u0438
    \u043B\u0435\u0432\u043E\u0439 \u043A\u043D\u043E\u043F\u043A\u0438 \u043C\u044B\u0448\u0438."
  - "\u0412\u043E \u0432\u043A\u043B\u0430\u0434\u043A\u0435 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044F
    \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u044C
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B, \u0432\u044B\u0431\u0435\u0440\u0438
    \u043B\u044E\u0431\u043E\u0439 \u0434\u043E\u0431\u044B\u0442\u044B\u0439 \u0442\u043E\u0431\u043E\u044E
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u043D\u0430 \u043B\u0435\u0432\u0443\u044E
    \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438 \u0438 \u043F\u0440\u043E\u0434\u0430\u0439."
  - "\u041F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u0434\u0430\u0436\u0438 \u0443
    \u0442\u0435\u0431\u044F \u043F\u0440\u0438\u0431\u0430\u0432\u0438\u043B\u0438\u0441\u044C
    \u0434\u0435\u043D\u044C\u0433\u0438, \u0438\u0445 \u043C\u043E\u0436\u043D\u043E
    \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0432 \u043F\u0440\u0430\u0432\u043E\u043C
    \u0432\u0435\u0440\u0445\u043D\u0435\u043C \u0443\u0433\u043B\u0443 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044F.
    \u041F\u0435\u0440\u0435\u0439\u0434\u0438 \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
    \u0432\u043A\u043B\u0430\u0434\u043A\u0443 \u043C\u043E\u043B\u043E\u0442\u043A\u0430."
  - "\u0412 \u044D\u0442\u043E\u0439 \u0447\u0430\u0441\u0442\u0438 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044F
    \u043C\u043E\u0436\u043D\u043E \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B, \u0447\u0442\u043E\u0431\u044B
    \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0432\u0441\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0435
    \u0441\u043F\u043E\u0441\u043E\u0431\u044B \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F,
    \u043D\u0430\u0436\u043C\u0438 \u043D\u0430 \u043A\u043D\u0438\u0433\u0443 \u0432
    \u044D\u0442\u043E\u043C \u043E\u043A\u043D\u0435."
  - "\u0414\u0430\u043B\u0435\u0435 \u0434\u0430\u0432\u0430\u0439 \u043F\u0435\u0440\u0435\u0439\u0434\u0451\u043C
    \u0432 \u043E\u043A\u043D\u043E \u043F\u0435\u0447\u043A\u0438, \u0432\u044B\u0431\u0435\u0440\u0438
    \u0435\u0451 \u0432 \u0432\u0435\u0440\u0445\u043D\u0435\u043C \u043C\u0435\u043D\u044E."
  - "\u0422\u0443\u0442 \u0432\u0441\u0451 \u043F\u0440\u043E\u0441\u0442\u043E.
    \u0421\u043D\u0438\u0437\u0443 \u043C\u044B \u043B\u043E\u0436\u0438\u043C \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u0443,
    \u0430 \u0441\u0432\u0435\u0440\u0445\u0443 \u0442\u043E, \u0447\u0442\u043E
    \u043C\u044B \u0445\u043E\u0442\u0438\u043C \u043F\u043E\u0434\u0436\u0430\u0440\u0438\u0442\u044C,
    \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440 \u043C\u043E\u0436\u043D\u043E
    \u043F\u0435\u0440\u0435\u043F\u043B\u0430\u0432\u0438\u0442\u044C \u0436\u0435\u043B\u0435\u0437\u043D\u0443\u044E
    \u0440\u0443\u0434\u0443 \u0432 \u0436\u0435\u043B\u0435\u0437\u043D\u044B\u0439
    \u0441\u043B\u0438\u0442\u043E\u043A."
  - "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435 \u043E\u043A\u043D\u043E
    - \u043A\u043E\u043C\u043F\u0430\u0441, \u0442\u0443\u0442 \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
    \u0437\u0430 \u0434\u0435\u043D\u044C\u0433\u0438 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u044C
    \u043D\u043E\u0432\u044B\u0435 \u0443\u0447\u0430\u0441\u0442\u043A\u0438 \u0437\u0435\u043C\u043B\u0438,
    \u0433\u0434\u0435 \u0431\u0443\u0434\u0443\u0442 \u0440\u0435\u0441\u0443\u0440\u0441\u044B
    \u0438 \u043D\u043E\u0432\u044B\u0435 \u043F\u043E\u0440\u0442\u0430\u043B\u044B
    \u0434\u043B\u044F \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u044F \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432.
    \u0421 \u043A\u0430\u0436\u0434\u043E\u0439 \u043A\u0443\u043F\u043B\u0435\u043D\u043D\u043E\u0439
    \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0435\u0439 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
    \u043F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u0431\u0443\u0434\u0435\u0442
    \u0440\u0430\u0441\u0442\u0438."
  - "\u0414\u0430\u043B\u0435\u0435 \u0438\u0434\u0451\u0442 \u043E\u043A\u043D\u043E
    \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F, \u0441\u044E\u0434\u0430
    \u043C\u043E\u0436\u043D\u043E \u043B\u043E\u0436\u0438\u0442\u044C \u0440\u0430\u0437\u043D\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u043E\u0435
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432,
    \u0434\u043B\u044F \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F \u0441\u0435\u0431\u044F
    \u0438\u043B\u0438 \u0441\u0432\u043E\u0435\u0439 \u0431\u0430\u0437\u044B, \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439
    \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C \u043B\u044E\u0431\u043E\u0439
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0432 \u0441\u043B\u043E\u0442 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F."
  - "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u043E\u043A\u043D\u043E
    \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044F - \u044D\u0442\u043E \u043C\u0430\u0433\u0430\u0437\u0438\u043D.
    \u0417\u0430 \u0434\u0435\u043D\u044C\u0433\u0438 \u043C\u043E\u0436\u043D\u043E
    \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u044C \u0440\u0435\u0441\u0443\u0440\u0441\u044B,
    \u0438\u043B\u0438 \u0436\u0435, \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0431\u0443\u0434\u0435\u0442 \u0434\u0430\u0432\u0430\u0442\u044C
    \u0432\u0441\u0435\u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u044B
    \u0438 \u0431\u043E\u043D\u0443\u0441\u044B."
  - "\u0415\u0441\u043B\u0438 \u0442\u044B \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440
    \u0432 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435, \u0432\u044B\u0439\u0434\u0438
    \u0438\u0437 \u043D\u0435\u0433\u043E \u0438 \u043D\u0430\u0436\u043C\u0438 \u043D\u0430
    esc, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043F\u0430\u0441\u0442\u044C
    \u0432 \u043C\u0435\u043D\u044E."
  - "\u0422\u0443\u0442 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E,
    \u043C\u043E\u0436\u043D\u043E \u0433\u043B\u044F\u043D\u0443\u0442\u044C \u0442\u0432\u043E\u044E
    \u043D\u044B\u043D\u0435\u0448\u043D\u044E\u044E \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0443.
    \u0442\u0430\u043A\u0436\u0435 \u0442\u0443\u0442 \u0435\u0441\u0442\u044C \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438,
    \u0438\u043B\u0438 \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
    \u0438\u0433\u0440\u0443. \u0414\u0430\u0432\u0430\u0439 \u0443\u0436\u0435 \u044D\u0442\u043E
